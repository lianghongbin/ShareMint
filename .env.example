# 复制为 .env 后再启动：cp .env.example .env

# Django
DEBUG=1
SECRET_KEY=please-change-this-to-a-random-secret-key
ALLOWED_HOSTS=*
RUNSERVER_PORT=9000

# 数据库（Docker 内持久化卷路径，一般不用改）
DATABASE_PATH=/data/db.sqlite3

# 初始管理员（首次启动自动创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ShareMint@2026
DEFAULT_ADMIN_EMAIL=admin@sharemint.local

# Gunicorn
GUNICORN_WORKERS=2

# 生产环境示例（按需启用）
# DEBUG=0
# ALLOWED_HOSTS=your.domain.com
# CSRF_TRUSTED_ORIGINS=https://your.domain.com
